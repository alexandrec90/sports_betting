# Keep the build context small and keep secrets out of the image.
#
# `.env` is the important line here: it is gitignored, so it never reaches the repo,
# but without this it WOULD be copied into the image by `COPY . .`.
.env
.env.*
!.env.example

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]

.pytest_cache
.ruff_cache
.mypy_cache
.hypothesis
.coverage
htmlcov

logs
artifacts
reports
data

node_modules
frontend/dist
frontend/.vite

.vscode
.claude
.agents
docs
*.md
!README.md

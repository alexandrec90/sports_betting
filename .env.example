# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=sports_betting

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 4. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py sports_betting
DB_HOST_PORT=5436

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://sports_betting:sports_betting_local_dev@127.0.0.1:5436/sports_betting
POSTGRES_USER=sports_betting
POSTGRES_PASSWORD=sports_betting_local_dev
POSTGRES_DB=sports_betting

# ---------------------------------------------------------------------------
# Data lake (bronze tier)
# ---------------------------------------------------------------------------
# The shared bronze tier. This IS the pooled lake: the default points at the sibling
# data-lake checkout's data dir, so every dataset written here lands in the same tree
# other projects read, under the `_catalog/<dataset>.json` contract described in
# .claude/rules/data-lake.md. Override with an absolute path where the projects are
# not siblings; docker-compose mounts the same host dir at /data-lake.
#
# Pooling is not offloading. The lake's storage tier today is LOCAL DISK — the whole
# tree counts against this machine's free space, and BulkArchive keeps both the
# original download and the converted Parquet. Check free space before a backfill.
ARCHIVE_ROOT=../data-lake/data/archive

# The mirror. `sports-betting archive-sync` uploads the tree above to this backend,
# verifies each object by reading it back, and with --prune deletes the local *source*
# artifacts it has verified (never the Parquet — the next bulk import re-opens that).
#
# Needs the sibling lake package, which is not a declared dependency because CI and the
# container image have no sibling checkout:  uv pip install -e ../data-lake[archive]
#
#   none   the default. Local-only; nothing is offloaded.
#   local  mirror to another directory — an external drive is a real answer to a full
#          disk. ARCHIVE_LOCAL_DIR must differ from ARCHIVE_ROOT.
#   s3     any S3-compatible bucket. The bucket is PRIVATE, always — .claude/rules/data-lake.md.
#
# For Cloudflare R2 the credentials are an S3-compatible ACCESS KEY PAIR minted under
# R2 > Manage API Tokens. A general Cloudflare API token will NOT authenticate against
# the S3 endpoint. The endpoint is account-specific and the region must be "auto".
# R2 buckets are private by default, but enabling an r2.dev or custom domain makes objects
# public and S3 credentials cannot detect that — only the Cloudflare API or dashboard can.
ARCHIVE_BACKEND=none
ARCHIVE_LOCAL_DIR=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT_URL=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_PREFIX=

# ---------------------------------------------------------------------------
# Sports data providers
# ---------------------------------------------------------------------------
# TheSportsDB publishes 123 as its shared v1 free key. A supporter key raises
# response limits; keep private keys in .env, never in this template.
SPORTSDB_API_KEY=123
SPORTSDB_TIMEOUT_SECONDS=20
# Comma-separated filters. Each sport costs one request per scheduler run.
SPORTSDB_SPORTS="Soccer,Baseball,Basketball,Ice Hockey,American Football"

# Free account: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Free account: https://app.balldontlie.io/signup
BALLDONTLIE_API_KEY=
# Only nba/nfl/mlb games are free. EPL /matches needs a paid ALL-STAR plan (checked
# 2026-08-08); adding `epl` on a free key makes that sport fail every run.
BALLDONTLIE_SPORTS=nba,nfl,mlb

# Free key: https://the-odds-api.com/#get-access
THE_ODDS_API_KEY=
# The free Starter plan is 500 credits/month for all sports (re-checked 2026-10-02); one
# moneyline call costs one credit per region and nothing when it returns no games. These
# are focus leagues in priority order (globs allowed). Each run fetches only in-season
# ones with a game inside the lookahead window, stalest first, within an even share of
# the month's remaining budget. Keys: https://the-odds-api.com/sports-odds-data/sports-apis.html
THE_ODDS_API_SPORTS=icehockey_nhl,americanfootball_nfl,basketball_nba,baseball_mlb,americanfootball_cfl,americanfootball_ncaaf,soccer_epl,soccer_uefa_champs_league,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_usa_mls,tennis_atp_*,tennis_wta_*
# Required by the v4 odds endpoint; selects which bookmakers are returned. Each extra
# region multiplies the cost of every call.
THE_ODDS_API_REGIONS=us
# Our monthly ceiling, below the provider's 500 so manual checks never run it dry.
THE_ODDS_API_MONTHLY_BUDGET=450
THE_ODDS_API_LOOKAHEAD_HOURS=36

# One key covers every api-sports.io sport API (100 free requests/day each).
# Free account: https://dashboard.api-football.com/register
# Run `sports-betting probe-api-sports` to see what the free plan really returns.
API_SPORTS_KEY=
# Soccer pre-match odds (Pinnacle, Bet365, ...). Each collected day costs one fixtures
# call, the date pages (10 games each; free plans stop at page 3), then one call per game
# in API_SPORTS_LEAGUES. The free plan allows 100 requests a day (UTC); this ceiling
# leaves room for checks.
API_SPORTS_DAILY_BUDGET=90
API_SPORTS_MAX_PAGES=3
# League ids, most important first. Only leagues whose odds coverage is on; the Champions
# League, Portugal, Turkey and others have none (The Odds API covers the UCL instead).
API_SPORTS_LEAGUES=39,140,135,78,61,253,479,262,40,88,179,71,128,141,41,42,218,197,239,265,292
# Days collected once per UTC day, starting today (2 = today and tomorrow).
API_SPORTS_DAYS=2
# Bet id requested: 1 is Match Winner. Blank keeps every bet (much larger snapshots).
API_SPORTS_BET=1
API_SPORTS_REFRESH_FILE=logs/api-sports-refresh.json

# All collection jobs run every six hours. Six is the minimum accepted value.
COLLECTION_INTERVAL_HOURS=6
SCHEDULER_HEALTH_FILE=logs/scheduler-health.json
PROVIDER_QUOTA_FILE=logs/provider-quotas.json
ODDS_REFRESH_FILE=logs/odds-api-refresh.json

# ---------------------------------------------------------------------------
# Free historical bulk imports (no API keys)
# ---------------------------------------------------------------------------
# Downloads are streamed, resumable, capped at 2 GB compressed per artifact, and
# paced at one request/second. Raise the size cap only after checking free disk.
BULK_REQUEST_INTERVAL_SECONDS=1
BULK_MAX_DOWNLOAD_BYTES=2000000000

# Backfills are manual. Set this true to add one serialized weekly refresh job for
# current-season files. MoneyPuck permits non-commercial use only; remove it from
# the source list unless that fits the deployment's use.
BULK_REFRESH_ENABLED=false
BULK_REFRESH_SOURCES=football-data,nflverse,moneypuck
BULK_FOOTBALL_LEAGUES=E0,D1,I1,SP1,F1
# StatsBomb needs explicit competition:season IDs from `sports-betting statsbomb-list`.
# Add `statsbomb` to BULK_REFRESH_SOURCES when targets are configured.
STATSBOMB_REFRESH_TARGETS=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=sports_betting
OTEL_RESOURCE_ATTRIBUTES=service.name=sports_betting,service.instance.id=sports_betting,deployment.environment=local
# 4318 is a WORKSPACE SINGLETON, not this project's slot. One OTLP collector serves
# every checkout (it runs in carameli's `monitoring` compose profile); devkit's
# `ports.toml` pins the number under `[shared]`, not `[services]`. This was 4322 —
# slot 4 of a per-project `otel_http` base — and nothing listened there, which an
# OTLP exporter reports by retrying in the background forever. Keep it equal to
# `.claude/settings.json`; `tests/test_telemetry_endpoint.py` enforces that.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

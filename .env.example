# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=sports_betting

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 4. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py sports_betting
DB_HOST_PORT=5436

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The host-side URL. It must agree with DB_HOST_PORT above — that is the pairing
# that breaks first when a worktree's ports are edited by hand.
DATABASE_URL=postgresql+psycopg://sports_betting:sports_betting_local_dev@127.0.0.1:5436/sports_betting
POSTGRES_USER=sports_betting
POSTGRES_PASSWORD=sports_betting_local_dev
POSTGRES_DB=sports_betting

# ---------------------------------------------------------------------------
# Data lake (bronze tier)
# ---------------------------------------------------------------------------
# S3-compatible object storage holding immutable Hive-partitioned Parquet, read
# through a DuckDB lens. The bucket is PRIVATE, always — see
# .claude/rules/data-lake.md for what may and may not be written to it.
# Leave these unset to keep the archive local-only (ARCHIVE_ROOT).
# Keep local bronze data in the sibling data-lake checkout. Override this with an
# absolute path in deployments where the projects are not siblings.
ARCHIVE_ROOT=../data-lake/data/archive
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Sports data providers
# ---------------------------------------------------------------------------
# TheSportsDB publishes 123 as its shared v1 free key. A supporter key raises
# response limits; keep private keys in .env, never in this template.
SPORTSDB_API_KEY=123
SPORTSDB_TIMEOUT_SECONDS=20
# Comma-separated filters. Each sport costs one request per scheduler run.
SPORTSDB_SPORTS="Soccer,Baseball,Basketball,Ice Hockey,American Football"

# Free account: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Free account: https://app.balldontlie.io/signup
BALLDONTLIE_API_KEY=
BALLDONTLIE_SPORTS=nba,nfl,mlb,epl

# Free key: https://theoddsapi.com/start
THE_ODDS_API_KEY=
# The free plan currently permits only these two sport keys.
THE_ODDS_API_SPORTS=basketball_nba,baseball_mlb

# All collection jobs run every six hours. Six is the minimum accepted value: with
# the two free Odds API sports this consumes at most 8 of 25 daily requests.
COLLECTION_INTERVAL_HOURS=6
SCHEDULER_HEALTH_FILE=logs/scheduler-health.json
PROVIDER_QUOTA_FILE=logs/provider-quotas.json

# ---------------------------------------------------------------------------
# Free historical bulk imports (no API keys)
# ---------------------------------------------------------------------------
# Downloads are streamed, resumable, capped at 2 GB compressed per artifact, and
# paced at one request/second. Raise the size cap only after checking free disk.
BULK_REQUEST_INTERVAL_SECONDS=1
BULK_MAX_DOWNLOAD_BYTES=2000000000

# Backfills are manual. Set this true to add one serialized weekly refresh job for
# current-season files. MoneyPuck permits non-commercial use only; remove it from
# the source list unless that fits the deployment's use.
BULK_REFRESH_ENABLED=false
BULK_REFRESH_SOURCES=football-data,nflverse,moneypuck
BULK_FOOTBALL_LEAGUES=E0,D1,I1,SP1,F1
# StatsBomb needs explicit competition:season IDs from `sports-betting statsbomb-list`.
# Add `statsbomb` to BULK_REFRESH_SOURCES when targets are configured.
STATSBOMB_REFRESH_TARGETS=

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=sports_betting
OTEL_RESOURCE_ATTRIBUTES=service.name=sports_betting,service.instance.id=sports_betting,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4322
